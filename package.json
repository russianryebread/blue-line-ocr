{
  "name": "rink-record",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "cf:types": "wrangler types",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hockey-scorecards --local",
    "db:migrate:remote": "wrangler d1 migrations apply hockey-scorecards --remote"
  },
  "dependencies": {
    "hono": "^4.7.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8",
    "wrangler": "^4.16.0"
  }
}
